# Picture panel for the CNN test: a thin box with a car photo on its front face.
# It stands 6.5 cm in front of the e-puck camera.
Solid {
  translation -0.187 -0.3 0.03
  name "car_panel"
  children [
    Shape {
      appearance PBRAppearance {
        baseColorMap ImageTexture {
          url [
            "textures/car.jpg"
          ]
        }
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.01 0.06 0.06
      }
    }
  ]
  boundingObject Box {
    size 0.01 0.06 0.06
  }
}
